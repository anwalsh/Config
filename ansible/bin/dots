#!/bin/bash

DOTFILES_DIR="$HOME/GitLocal/github.com/anwalsh/dots"
ANSIBLE_DIR="$DOTFILES_DIR/ansible"

set -e

# Here be dragons
function macos_setup() {
  if ! [ -x "$(command -v brew)" ]; then
    echo "Installing Homebrew"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    echo >> /Users/andy/.zprofile
    echo 'eval "$(/opt/homebrew/bin/brew shellenv)"' >> /Users/andy/.zprofile
    eval "$(/opt/homebrew/bin/brew shellenv)"
  fi
  if ! [ -x "$(command -v git)" ]; then
    echo "Installing Git"
    brew install git
  fi
  if ! [ -x "$(command -v ansible)" ]; then
    echo "Installing Ansible"
    brew install ansible
  fi
  if ! [ -x "$(command -v op)" ]; then
    echo "Installing 1Password CLI"
    brew install 1password
    brew install 1password-cli
    echo "Setting up 1Password CLI"
    # press any key to continue
    read -n 1 -s -r -p "Press any key to continue"
    echo "[✓] 1Password CLI setup complete"
  fi
  if ! [ -x "$(command xcode-select -p)" ]; then
    echo "Setting up Xcode"
    xcode-select --install
    sudo xcodebuild -license
  fi
}

detect_os() {
  echo $(uname -s | tr '[:upper:]' '[:lower:]')
}

machine_os=$(detect_os)
echo "Detected OS as: $machine_os"
echo "Loading detected OS Setup config..."
case $machine_os in
  darwin)
    macos_setup
    ;;
  *)
    echo "Unsupported..."
    ;;
esac

if ! [ -d "$HOME"/.config/ ]; then
    mkdir "$HOME"/.config/
fi

ansible-playbook -K "$ANSIBLE_DIR/main.yml" "$@"
